# Conexión a PostgreSQL (docker compose levanta una en localhost:5432)
DATABASE_URL="postgresql://ligatracker:ligatracker@localhost:5432/ligatracker"
# Base separada para los tests de integración
TEST_DATABASE_URL="postgresql://ligatracker:ligatracker@localhost:5432/ligatracker_test"
# Secreto para firmar la sesión (mínimo 32 caracteres). Generar con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# Súper administrador que crea el seed
SEED_SUPERADMIN_EMAIL="admin@ligatracker.local"
SEED_SUPERADMIN_PASSWORD="cambia-esta-clave"
